<nav aria-label="breadcrumb" class="card rounded shadow-sm mb-3 border-cyan-700">
    <div class="card-body">
        <ol class="breadcrumb mb-0">
            <% breadcrumbs.forEach(item => { %>
                <li class="breadcrumb-item <%= !item.url ? 'fw-semibold text-cyan-700' : '' %>">
                    <% if (item.url) { %>
                        <a href="<%= item.url %>" class="text-decoration-none border-0 rounded text-secondary p-2 hover-text-primary">
                            <%= item.name %>
                        </a>
                    <% } else { %>
                        <%= item.name %>
                    <% } %>
                </li>
            <% }) %>
        </ol>
    </div>
</nav>

<style>
    .breadcrumb {
        background-color: transparent;
        font-size: 0.95rem;
    }
    .breadcrumb-item + .breadcrumb-item::before {
        color: #6c757d;
        content: "›";
        font-weight: bold;
    }
    .hover-text-primary:hover {
        color: #055160 !important;
        background-color: #08799024;
    }
</style>

