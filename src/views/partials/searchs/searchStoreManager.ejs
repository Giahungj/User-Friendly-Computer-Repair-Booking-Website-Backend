<form method="GET" action="/admin/cua-hang-truong/danh-sach" class="mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-11">
            <input type="text" name="q" class="form-control" placeholder="Tìm kiếm cửa hàng trưởng theo tên, email, số điện thoại, cửa hàng..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        </div>
        <div class="col text-end">
            <button class="btn btn-custom w-100 text-white" type="submit"
                style="background-color: #2196f3">
                <i class="fa-solid fa-magnifying-glass"></i> Tìm
            </button>
        </div>
    </div>
</form>
