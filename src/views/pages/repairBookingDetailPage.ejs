<div class="container mt-4 mb-5">
    <!-- Card: Tiêu đề và nút thêm -->
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h5 class="fw-semibold text-dark mb-0">Danh Sách Lịch Sửa Chữa</h5>
			<a href="javascript:history.back()" class="btn btn-secondary btn-sm">Quay lại</a>
        </div>
    </div>
  <div class="bg-white rounded p-4" style="max-width: 600px; margin: auto; border: 1px solid #dee2e6;">
    <!-- Header -->
    <div class="text-center mb-4">
      <h4 class="fw-bold mb-1">Chi Tiết Đơn Đặt Lịch</h4>
      <p class="text-muted mb-0">Thông tin chi tiết đơn đặt lịch</p>
      <hr class="my-3">
    </div>

    <!-- Người dùng -->
    <div class="mb-4">
      <h6 class="text-secondary fw-bold mb-3"><i class="fa-solid fa-users me-1"></i> Thông tin người dùng</h6>
      <div class="row g-3">
        <% if (customerData && customerData.User) { %>
          <div class="col-12">
            <div class="p-3 border rounded">
              <h6 class="text-secondary fw-bold mb-2"><i class="fa-solid fa-user me-1"></i> Khách hàng</h6>
              <div class="d-flex align-items-center mb-2">
                <img src="/images/<%= customerData.User.avatar || 'user.png' %>" class="rounded-circle me-2" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/user.png';">
                <div>
                  <p class="mb-0"><strong>Tên:</strong> <%= customerData.User.name %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-phone me-1"></i> <%= customerData.User.phone || '-' %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-envelope me-1"></i> <%= customerData.User.email || '-' %></p>
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <% if (managerData && managerData.User) { %>
          <div class="col-12">
            <div class="p-3 border rounded">
              <h6 class="text-secondary fw-bold mb-2"><i class="fa-solid fa-user-tie me-1"></i> Quản lý Cửa hàng</h6>
              <div class="d-flex align-items-center mb-2">
                <img src="/images/<%= managerData.User.avatar || 'user.png' %>" class="rounded-circle me-2" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/user.png';">
                <div>
                  <p class="mb-0"><strong>Tên:</strong> <%= managerData.User.name %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-phone me-1"></i> <%= managerData.User.phone || '-' %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-envelope me-1"></i> <%= managerData.User.email || '-' %></p>
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <% if (technicianData && technicianData.User) { %>
          <div class="col-12">
            <div class="p-3 border rounded">
              <h6 class="text-secondary fw-bold mb-2"><i class="fa-solid fa-user-wrench me-1"></i> Kỹ thuật viên</h6>
              <div class="d-flex align-items-center mb-2">
                <img src="/images/<%= technicianData.User.avatar || 'user.png' %>" class="rounded-circle me-2" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/user.png';">
                <div>
                  <p class="mb-0"><strong>Tên:</strong> <%= technicianData.User.name || 'Chưa chỉ định' %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-phone me-1"></i> <%= technicianData.User.phone || '-' %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-envelope me-1"></i> <%= technicianData.User.email || '-' %></p>
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <% if (!customerData && !managerData && !technicianData) { %>
          <div class="alert alert-warning text-center mb-0">Không có thông tin người dùng.</div>
        <% } %>
      </div>
    </div>

    <!-- Lịch đặt -->
    <div class="mb-4">
		<h6 class="text-secondary fw-bold mb-3"><i class="fa-solid fa-calendar-days me-1"></i> Chi tiết lịch đặt</h6>
		<% if (repairBooking) { %>
			<div class="p-3 border rounded">
				<p class="mb-1"><strong>Mã đặt lịch:</strong> <%= repairBooking.booking_id %></p>
				<p class="mb-1"><strong>Thiết bị:</strong> <%= repairBooking.device_type || '-' %></p>
				<p class="mb-1"><strong>Hãng:</strong> <%= repairBooking.brand || '-' %></p>
				<p class="mb-1"><strong>Ngày đặt:</strong> 
					<%= repairBooking.booking_date 
					? new Date(repairBooking.booking_date).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) 
					: '-' %>
				</p>
				<p class="mb-1"><strong>Giờ đặt:</strong> <%= repairBooking.booking_time || '-' %></p>
				<p class="mb-1"><strong>Mô tả lỗi:</strong> <%= repairBooking.issue_description || 'Không có' %></p>
				<p class="mb-1"><strong>Trạng thái:</strong>
					<span class="badge 
					<%= repairBooking.status === 'pending' ? 'bg-warning text-dark' :
						repairBooking.status === 'completed' ? 'bg-success' :
						repairBooking.status === 'in-progress' ? 'bg-info text-dark' : 'bg-secondary' %>">
					<%= repairBooking.status || 'Không xác định' %>
					</span>
				</p>
			</div>
		<% } else { %>
			<div class="alert alert-warning mb-0">Không tìm thấy thông tin đặt lịch.</div>
		<% } %>
	</div>

			<!-- Lịch sử -->
			<div class="mb-3">
				<h6 class="text-secondary fw-bold mb-3"><i class="fa-solid fa-clock-rotate-left me-1"></i> Lịch sử thao tác</h6>
				<% if (historyData && historyData.length > 0) { %>
					<ul class="list-group">
					<% historyData.forEach(item => { %>
						<li class="list-group-item d-flex justify-content-between">
							<span><strong><%= item.action %></strong> - <%= item.notes || '-' %></span>
							<small class="text-muted"><%= new Date(item.createdAt).toLocaleString('vi-VN') %></small>
						</li>
					<% }) %>
					</ul>
				<% } else { %>
					<p class="text-muted">Chưa có lịch sử cho đơn này.</p>
				<% } %>
			</div>

    <!-- Chi nhánh -->
    <div class="mb-4">
      <h6 class="text-secondary fw-bold mb-3"><i class="fa-solid fa-store me-1"></i> Thông tin chi nhánh</h6>
      <% if (storeData) { %>
        <div class="p-3 border rounded">
          <p class="mb-1"><strong>Tên chi nhánh:</strong> <%= storeData.name || '-' %></p>
          <p class="mb-1"><strong>Địa chỉ:</strong> <%= storeData.address || '-' %></p>
          <p class="mb-1"><strong>Số điện thoại:</strong> <%= storeData.phone || '-' %></p>
          <p class="mb-1"><strong>Email:</strong> <%= storeData.email || '-' %></p>
        </div>
      <% } else { %>
        <div class="alert alert-warning mb-0">Không có thông tin chi nhánh.</div>
      <% } %>
    </div>

    <!-- Footer -->
    <div class="text-center mt-4">
      <hr class="my-3">
      <p class="text-muted mb-0">Cảm ơn quý khách đã sử dụng dịch vụ của chúng tôi!</p>
    </div>
  </div>
</div>