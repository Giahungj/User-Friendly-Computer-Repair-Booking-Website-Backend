<!-- Thêm Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="card shadow-sm border-0 rounded p-3">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h5 class="mb-0">
			Biểu đồ số đơn hoàn thành / bị hủy theo 
			<%= type === 'store' ? 'chi nhánh' : 'kỹ thuật viên' %>
		</h5>
		<div class="text-end small text-muted">
			<p class="mb-0"><strong>Loại:</strong> <%= type === 'store' ? 'Chi nhánh' : 'Kỹ thuật viên' %></p>
			<p class="mb-0"><strong>Từ ngày:</strong> <%= fromDate %></p>
			<p class="mb-0"><strong>Đến ngày:</strong> <%= toDate %></p>
		</div>
	</div>
    
    <form action="/reports/performance" method="get" class="card shadow-sm border-0 rounded p-3 mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Thống kê theo</label>
                <select name="type" class="form-select">
                    <option value="technician" <%= type === 'technician' ? 'selected' : '' %>>Kỹ thuật viên</option>
                    <option value="store" <%= type === 'store' ? 'selected' : '' %>>Chi nhánh</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Từ ngày</label>
                <input type="date" name="fromDate" value="<%= fromDate %>" class="form-control" required>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Đến ngày</label>
                <input type="date" name="toDate" value="<%= toDate %>" class="form-control" required>
            </div>

            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-primary rounded-pill">
                    <i class="bi bi-bar-chart-fill me-1"></i> Thống kê
                </button>
            </div>
        </div>
    </form>

	<canvas id="jobChart" height="120" width="300"></canvas>
</div>

<script>
	const data = <%- JSON.stringify(data) %>;
	const isStore = "<%= type %>" === "store";

	const ctx = document.getElementById("jobChart").getContext("2d");
	const chart = new Chart(ctx, {
		type: "bar",
		data: {
			labels: data.map(t => isStore ? t.storeName : t.technicianName),
			datasets: [
				{
					label: "Hoàn thành",
					data: data.map(t => t.completedJobs),
					backgroundColor: "#4CAF50",
					borderWidth: 1
				},
				{
					label: "Bị hủy",
					data: data.map(t => t.cancelledJobs),
					backgroundColor: "#E53935",
					borderWidth: 1
				}
			]
		},
		options: {
			responsive: true,
			scales: {
				y: {
					beginAtZero: true,
					title: {
						display: true,
						text: "Số lượng đơn"
					}
				},
				x: {
					title: {
						display: true,
						text: isStore ? "Chi nhánh" : "Kỹ thuật viên"
					}
				}
			},
			plugins: {
				legend: { position: "bottom" },
				tooltip: { mode: "index", intersect: false }
			}
		}
	});
</script>
