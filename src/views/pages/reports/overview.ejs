<div class="container mt-3">
	<!-- Card 1: Tiêu đề và form lọc -->
	<div class="card mb-3">
		<div class="card-body d-flex justify-content-between align-items-center">
			<h3 class="fw-semibold text-dark mb-0">Báo Cáo Tổng Quan</h3>
			<form action="http://localhost:8080/reports/overview" method="get" class="d-flex align-items-center gap-2">
				<label class="me-2 mb-0">Từ:</label>
				<input type="date" name="fromDate" class="form-control form-control-sm me-2" value="<%= fromDate %>">
				<label class="me-2 mb-0">Đến:</label>
				<input type="date" name="toDate" class="form-control form-control-sm me-2" value="<%= toDate %>">
				<button type="submit" class="btn btn-primary btn-sm">Xem</button>
			</form>
		</div>
	</div>

	<div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title fw-medium text-dark mb-3">Thống Kê Chung</h5>
            <div class="row">
                <div class="col-md-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Tổng đơn:</span>
                            <span class="<%= !overviewReport.totalBookings ? 'text-danger' : '' %>">
                                <%= overviewReport.totalBookings%>
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Hoàn thành:</span>
                            <span class="<%= !overviewReport.completedRepairs ? 'text-danger' : '' %>">
                                <%= overviewReport.completedRepairs%>
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Đang thực hiện:</span>
                            <span class="<%= !overviewReport.ongoingRepairs ? 'text-danger' : '' %>">
                                <%= overviewReport.ongoingRepairs%>
                            </span>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Đã hủy:</span>
                            <span class="<%= !overviewReport.canceledRepairs ? 'text-danger' : '' %>">
                                <%= overviewReport.canceledRepairs%>
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Chờ xử lý:</span>
                            <span class="<%= !overviewReport.pendingRepairs ? 'text-danger' : '' %>">
                                <%= overviewReport.pendingRepairs %>
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Tỷ lệ hoàn thành:</span>
                            <span class="<%= !overviewReport.completionRate ? 'text-danger' : '' %>">
                                <%= overviewReport.completionRate + '%' %>
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

	<!-- Card 3: Biểu đồ -->
	<div class="card mb-3">
		<div class="card-body">
			<h5 class="card-title fw-medium text-dark mb-3">Biểu Đồ Thống Kê Theo Ngày</h5>
			<div class="row">
				<div class="col-md-6">
					<canvas id="barChart" class="p-3"></canvas>
				</div>
				<div class="col-md-6">
					<canvas id="lineChart" class="p-3"></canvas>
				</div>
			</div>
		</div>
	</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
	const dailyStats = <%- JSON.stringify(dailyStats) %>;
	const labels = dailyStats.map(d => d.date);
	const total = dailyStats.map(d => d.totalBookings);
	const completed = dailyStats.map(d => d.completed);
	const cancelled = dailyStats.map(d => d.cancelled);
	const inProgress = dailyStats.map(d => d.inProgress);

	// Biểu đồ cột
	new Chart(document.getElementById('barChart'), {
		type: 'bar',
		data: {
			labels,
			datasets: [
				{ label: 'Tổng đơn', data: total, backgroundColor: 'rgba(54,162,235,0.6)' },
				{ label: 'Hoàn thành', data: completed, backgroundColor: 'rgba(75,192,192,0.6)' },
				{ label: 'Đã hủy', data: cancelled, backgroundColor: 'rgba(255,99,132,0.6)' },
				{ label: 'Đang thực hiện', data: inProgress, backgroundColor: 'rgba(255,206,86,0.6)' }
			]
		},
		options: {
			responsive: true,
			scales: { y: { beginAtZero: true } },
			plugins: { legend: { position: 'bottom' } }
		}
	});

	// Biểu đồ đường
	new Chart(document.getElementById('lineChart'), {
		type: 'line',
		data: {
			labels,
			datasets: [
				{ label: 'Tổng đơn', data: total, borderColor: 'rgba(54,162,235,1)', fill: false, tension: 0.2 },
				{ label: 'Hoàn thành', data: completed, borderColor: 'rgba(75,192,192,1)', fill: false, tension: 0.2 },
				{ label: 'Đã hủy', data: cancelled, borderColor: 'rgba(255,99,132,1)', fill: false, tension: 0.2 },
				{ label: 'Đang thực hiện', data: inProgress, borderColor: 'rgba(255,206,86,1)', fill: false, tension: 0.2 }
			]
		},
		options: {
			responsive: true,
			scales: { y: { beginAtZero: true } },
			plugins: { legend: { position: 'bottom' } }
		}
	});
</script>