<div class="container py-5">
    <!-- Card 1: Tiêu đề -->
      <div class="d-flex justify-content-between align-items-center">
        <h1 class="mb-4 text-cyan-700">Danh Sách Chuyên Môn</h1>
        <a href="/admin/chuyen-mon/them-moi" class="btn btn-outline-secondary bg-cyan-700 text-white">
            <i class="fa-solid fa-plus me-1"></i> Thêm chuyên môn
        </a>
    </div>

    <!-- Card 2: Table -->
    <div class="card mb-3">
        <div class="card-body">
            <% if (EC === 0 && specialties.length > 0) { %>
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Tên chuyên môn</th>
                            <th>Mô tả</th>
                            <th>Hình ảnh</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% specialties.forEach((spec, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td class="text-start"><%= spec.name %></td>
                               <td class="text-start" style="max-width:250px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    <%= spec.description || 'Không rõ' %>
                                </td>
                                <td>
                                    <% if (spec.image) { %>
                                        <img src="/images/<%= spec.image %>" alt="avatar" class="rounded" style="height:60px;">
                                    <% } else { %>
                                        <span class="text-danger">Không rõ</span>
                                        <span class="text-danger">/images/<%= spec.image %></span>
                                    <% } %>
                                </td>
                                <td><%= new Date(spec.createdAt).toLocaleDateString('vi-VN') %></td>
                                <td>
                                    <a href="/admin/chuyen-mon/<%= spec.specialty_id %>/cap-nhat" class="btn btn-sm btn-outline-primary me-1">Sửa</a>
                                    <!-- <form action="/admin/chuyen-mon/<%= spec.specialty_id %>/delete" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xác nhận xoá?')">Xóa</button>
                                    </form> -->
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <div class="alert alert-warning">Chưa có chuyên môn nào.</div>
            <% } %>
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <%- include('../../partials/common/pagination', {
                    currentPage: currentPage,
                    totalPages: totalPages,
                    baseUrl: '/admin/chuyen-mon/danh-sach'
                }) %>
            <% } %>
        </div>
    </div>
</div>