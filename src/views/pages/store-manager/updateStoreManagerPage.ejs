<div class="container py-5">
    <!-- Breadcrumb (có thể tái sử dụng) -->
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
        <%- include('../../partials/common/breadcrumb', { breadcrumbs }) %>
    <% } %>

     <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="mb-4 text-cyan-700">Cập Nhật Thông Tin Cửa Hàng Trưởng</h1>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
    </div>
   
    <div class="card border-cyan-700">
        <div class="card-body p-4">
            <form action="/admin/cua-hang-truong/<%= manager.User.user_id %>/cap-nhat" method="POST" enctype="multipart/form-data" class="row g-3">
                <div class="col-md-6">
                    <label for="name" class="form-label">Họ tên</label>
                    <input type="text" class="form-control" id="name" name="name" value="<%= manager.User.name %>" required>
                </div>
                <div class="col-md-6">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email" value="<%= manager.User.email %>" required>
                </div>
                <div class="col-md-6">
                    <label for="phone" class="form-label">Số điện thoại</label>
                    <input type="text" class="form-control" id="phone" name="phone" value="<%= manager.User.phone %>" required>
                </div>
                <div class="col-md-6">
                    <div class="mb-3 text-center">
                        <img id="avatarPreview" 
                            src="/images/<%= manager.User.avatar || '/images/doctor.png' %>" 
                            alt="Xem trước" 
                            class="rounded-circle shadow-sm" 
                            style="width: 150px; height: 150px; object-fit: cover; border: 2px solid #ddd;">
                    </div>
                    <label for="avatar" class="form-label">Ảnh đại diện (để trống nếu không đổi)</label>
                    <input type="file" class="form-control" id="avatar" name="avatar" accept="image/*">
                </div>
                <div class="col-md-6">
                    <label for="store" class="form-label">Cơ sở phụ trách</label>
                    <select class="form-select" id="store" name="store_id">
                        <option value="">-- Chọn cơ sở --</option>
                        <% stores.forEach(store => { %>
                            <option value="<%= store.store_id %>" <%= manager.Store && store.store_id === manager.Store.store_id ? 'selected' : '' %>><%= store.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="col-12 d-flex justify-content-end mt-3">
                    <button type="submit" class="btn btn-primary px-4">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const avatarInput = document.getElementById('avatar');
    const avatarPreview = document.getElementById('avatarPreview');

    avatarInput.addEventListener('change', () => {
        const file = avatarInput.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = e => {
                avatarPreview.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    });

    document.addEventListener("DOMContentLoaded", () => {
		const msg = "<%= typeof EM !== 'undefined' ? EM : '' %>";
		if (msg) alert(msg);
	});
</script>
