<div class="container mt-3">
    <!-- Card 1: Tiêu đề và nút quay lại -->
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h3 class="fw-semibold text-dark mb-0">Chi Tiết Người Dùng</h3>
            <a href="javascript:history.back()" class="btn btn-secondary btn-sm">Quay lại</a>
            <%= user.avatar %>
        </div>
    </div>

    <!-- Card: Thông tin người dùng -->
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title fw-medium text-dark mb-3">Thông Tin Chi Tiết</h5>
            <% if (user) { %>
                <div class="row">
                    <div class="col-md-4">
                        <table class="table table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th class="text-end" style="width:40%">Mã người dùng:</th>
                                    <td class="<%= !user.user_id ? 'text-danger' : '' %>"><%= user.user_id || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Họ tên:</th>
                                    <td class="<%= !user.name ? 'text-danger' : '' %>"><%= user.name || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Email:</th>
                                    <td class="<%= !user.email ? 'text-danger' : '' %>"><%= user.email || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Số điện thoại:</th>
                                    <td class="<%= !user.phone ? 'text-danger' : '' %>"><%= user.phone || 'Không rõ' %></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-4">
                        <table class="table table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th class="text-end" style="width:35%">Hình ảnh:</th>
                                    <td>
                                        <img src="/images<%= user.avatar %>"
                                             alt="Avatar"
                                             style="height: 80px; object-fit: cover; border: 2px solid #ccc;"
                                             onerror="this.onerror=null; this.src='/images/user.png';">
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="alert alert-warning mb-0">Không tìm thấy thông tin người dùng.</div>
            <% } %>
        </div>
    </div>
</div>