<div class="container mt-3">
    <!-- Card 1: Tiêu đề và nút quay lại -->
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h3 class="fw-semibold text-dark mb-0">Chi Tiết Cửa Hàng</h3>
            <a href="javascript:history.back()" class="btn btn-secondary btn-sm">Quay lại</a>
        </div>
    </div>

    <!-- Card: Thông tin cửa hàng -->
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title fw-medium text-dark mb-3">Thông Tin Chi Tiết</h5>
            <% if (store) { %>
                <div class="row">
                    <div class="col-md-4">
                        <table class="table table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th class="text-end" style="width:40%">Mã cửa hàng:</th>
                                    <td class="<%= !store.store_id ? 'text-danger' : '' %>"><%= store.store_id || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Tên cửa hàng:</th>
                                    <td class="<%= !store.name ? 'text-danger' : '' %>"><%= store.name || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Số điện thoại:</th>
                                    <td class="<%= !store.phone ? 'text-danger' : '' %>"><%= store.phone || 'Không rõ' %></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-4">
                        <table class="table table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th class="text-end" style="width:35%">Địa chỉ:</th>
                                    <td class="<%= !store.address ? 'text-danger' : '' %>"><%= store.address || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Ngày tạo:</th>
                                    <td class="<%= !store.createdAt ? 'text-danger' : '' %>">
                                        <%= store.createdAt ? new Date(store.createdAt).toLocaleString('vi-VN') : 'Không rõ' %>
                                    </td>
                                </tr>
                                <% if (store.updatedAt) { %>
                                    <tr>
                                        <th class="text-end">Ngày cập nhật:</th>
                                        <td class="<%= !store.updatedAt ? 'text-danger' : '' %>">
                                            <%= store.updatedAt ? new Date(store.updatedAt).toLocaleString('vi-VN') : 'Không rõ' %>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-4">
                        <table class="table table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th class="text-end" style="width:35%">Hình ảnh:</th>
                                    <td>
                                        <img src="/images/<%= store.store_image %>"
                                             alt="Store Image"
                                             style="height: 80px; object-fit: cover; border: 2px solid #ccc;"
                                             onerror="this.onerror=null; this.src='/images/user.png';">
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="alert alert-warning mb-0">Không tìm thấy thông tin cửa hàng.</div>
            <% } %>
        </div>
    </div>
</div>