<%
    function highlight(text, keyword) {
        if (!keyword) return text;
        const regex = new RegExp(`(${keyword})`, 'gi');
        return text.replace(regex, '<strong class="text-danger">$1</strong>');
    }
%>
<div class="container mt-3">
    <!-- Card 1: Tiêu đề và nút quay lại -->
	<div class="card mb-3">
		<div class="card-body d-flex justify-content-between align-items-center">
			<h3 class="fw-semibold text-dark mb-0">Danh sách kỹ thuật viên</h3>
            <div>
                <a href="/admin/ky-thuat-vien/them-moi" class="btn btn-sm btn-primary me-2">
                    <i class="fa-solid fa-plus"></i> Thêm kỹ thuật viên
                </a>
                <a href="javascript:history.back()" class="btn btn-sm btn-secondary">Quay lại</a>
            </div>
		</div>
	</div>
    <%- include('../partials/searchs/searchTechnician') %>

    <hr>

    <% if (Array.isArray(technicians) && technicians.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th>#</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th>Cửa hàng</th>
                        <th>Hoạt động gần nhất</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% technicians.forEach((tech, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%- highlight(tech.User.name || '', searchQuery) %></td>
                            <td><%- highlight(tech.User.email || '', searchQuery) %></td>
                            <td><%- highlight(tech.User.phone || '', searchQuery) %></td>
                            <td><%= tech.Store?.name || 'Chưa rõ' %></td>
                            <td><%= tech.User?.last_active ? new Date(tech.User?.last_active).toLocaleString('vi-VN') : 'Chưa đăng nhập' %></td>
                            <td class="text-center">
                                <a href="/admin/ky-thuat-vien/<%= tech.technician_id %>/chi-tiet"
                                    class="btn btn-sm btn-outline-primary">Xem</a>
                                <a href="/admin/ky-thuat-vien/<%= tech.technician_id %>/sua" 
                                    class="btn btn-sm btn-outline-primary" title="Sửa">Sửa</a>
                                <form action="/admin/ky-thuat-vien/<%= tech.technician_id %>/xoa" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"
                                            onclick="return confirm('Xác nhận xoá kỹ thuật viên này?')">
                                        Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="alert alert-info mb-0">Chưa có kỹ thuật viên nào được thêm.</div>
    <% } %>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <%- include('../partials/common/paginationmall', {
            currentPage: currentPage,
            totalPages: totalPages,
            baseUrl: '/admin/ky-thuat-vien/danh-sach'
        }) %>
    <% } %>
</div>
