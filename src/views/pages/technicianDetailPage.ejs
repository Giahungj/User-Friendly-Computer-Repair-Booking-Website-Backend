<div class="container mt-3">
	<!-- Card 1: Tiêu đề và nút quay lại -->
	<div class="card mb-3">
		<div class="card-body d-flex justify-content-between align-items-center">
			<h3 class="fw-semibold text-dark mb-0">Thông Tin Kỹ Thuật Viên</h3>
            <a href="javascript:history.back()" class="btn btn-secondary btn-sm">Quay lại</a>
		</div>
	</div>

	<!-- Card: Thông tin kỹ thuật viên & cửa hàng -->
	<div class="card mb-3">
		<div class="card-body">
			<h5 class="card-title fw-medium text-dark mb-3">Thông Tin Chi Tiết</h5>
			<div class="row">
				<div class="col-md-4">
					<table class="table table-bordered align-middle">
						<tbody>
							<tr>
								<th class="text-end" style="width:40%">Mã kỹ thuật viên:</th>
								<td class="<%= !data.technician_id ? 'text-danger' : '' %>"><%= data.technician_id || 'Không rõ' %></td>
							</tr>
							<tr>
								<th class="text-end">Họ tên:</th>
								<td class="<%= !data.User?.name ? 'text-danger' : '' %>"><%= data.User?.name || 'Không rõ' %></td>
							</tr>
							<tr>
								<th class="text-end">Email:</th>
								<td class="<%= !data.User?.email ? 'text-danger' : '' %>"><%= data.User?.email || 'Không rõ' %></td>
							</tr>
							<tr>
								<th class="text-end">Số điện thoại:</th>
								<td class="<%= !data.User?.phone ? 'text-danger' : '' %>"><%= data.User?.phone || 'Không rõ' %></td>
							</tr>
						</tbody>
					</table>
				</div>

				<div class="col-md-4">
					<table class="table table-bordered align-middle">
						<tbody>
							<tr>
								<th class="text-end" style="width:35%">Mã cửa hàng</th>
								<td class="<%= !data.Store?.store_id ? 'text-danger' : '' %>"><%= data.Store?.store_id || 'Không rõ' %></td>
							</tr>
							<tr>
								<th class="text-end">Tên cửa hàng</th>
								<td class="<%= !data.Store?.name ? 'text-danger' : '' %>"><%= data.Store?.name || 'Không rõ' %></td>
							</tr>
							<tr>
								<th class="text-end">Địa chỉ</th>
								<td class="<%= !data.Store?.address ? 'text-danger' : '' %>"><%= data.Store?.address || 'Không rõ' %></td>
							</tr>
							<tr>
								<th class="text-end">Hình ảnh</th>
								<td>
									<% if (data.Store?.store_image) { %>
										<img src="/images/<%= data.Store.store_image %>" alt="Store Image" style="height: 80px;">
									<% } else { %>
										<span class="text-danger">Không rõ</span>
									<% } %>
								</td>
							</tr>
						</tbody>
					</table>
				</div>

				<div class="col-md-4">
					<table class="table table-bordered align-middle">
						<tbody>
							<tr>
								<th class="text-end" style="width:35%">Chuyên ngành</th>
								<td class="<%= (!data.Specialties || data.Specialties.length === 0) ? 'text-danger' : '' %>">
									<% if (data.Specialties && data.Specialties.length > 0) { %>
										<%= data.Specialties.map(s => s.name).join(', ') %>
									<% } else { %>
										Không rõ
									<% } %>
								</td>
							</tr>
							<tr>
								<th class="text-end">Đánh giá trung bình</th>
								<td class="<%= !data.avg_rating ? 'text-danger' : '' %>">
									<%= data.avg_rating ? data.avg_rating + '/5' : 'Không rõ' %>
									<% if(data.avg_rating) { %>
										<span class="text-warning">★★★★★</span>
									<% } %>
									<%= data.total_reviews ? '(dựa trên ' + data.total_reviews + ' đánh giá)' : '' %>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

	<!-- Card 5: Đơn đặt lịch / công việc -->
	<div class="card mb-3">
		<div class="card-body">
			<h5 class="card-title mb-3">Đơn Đặt Lịch / Công Việc</h5>
			<table class="table table-hover">
				<thead class="text-center">
					<tr>
						<th>#</th>
						
						<th>Khách hàng</th>
						<th>Ngày đặt</th>
						<th>Thiết bị</th>
						<th>Trạng thái</th>
						<th>Hành động</th>
					</tr>
				</thead>
				<tbody>
					<% if (data.Bookings && data.Bookings.length > 0) { %>
						<% data.Bookings.forEach((item, index) => { %>
							<tr>
								<td class="text-center"><%= index + 1 %></td>
								
								<td><%= item.customer_name %></td>
								<td><%= new Date(item.booking_date).toLocaleDateString('vi-VN') %></td>
								<td><%= item.device_type %></td>
								<td class="<%= item.status === 'pending' ? 'bg-secondary text-white text-center' :
									item.status === 'in-progress' ? 'bg-warning text-dark text-center' :
									item.status === 'completed' ? 'bg-success text-white text-center' : 'bg-info text-white text-center' %>">
									<%= item.status %>
								</td>
								<td class="text-center">
									<a href="/admin/dat-lich/<%= item.booking_id %>/chi-tiet" class="btn btn-outline-info btn-sm">
										Xem chi tiết
									</a>
									<!-- <% if(item.status !== 'completed'){ %>
										<button class="btn btn-outline-primary btn-sm">Chuyển kỹ thuật viên</button>
										<button class="btn btn-outline-success btn-sm">Cập nhật trạng thái</button>
									<% } %> -->
								</td>
							</tr>
						<% }) %>
					<% } else { %>
						<tr>
							<td colspan="7" class="text-center text-muted">Chưa có đơn đặt lịch</td>
						</tr>
					<% } %>
				</tbody>
			</table>
		</div>
	</div>

	<!-- Card 7: Chức năng quản trị -->
	<div class="card">
		<div class="card-body">
			<h5 class="card-title fw-medium text-dark mb-3">Chức Năng Quản Trị</h5>
			<div class="d-flex gap-2">
				<button class="btn btn-warning">Ngưng hoạt động</button>
				<button class="btn btn-danger">Xóa kỹ thuật viên</button>
			</div>
		</div>
	</div>
</div>