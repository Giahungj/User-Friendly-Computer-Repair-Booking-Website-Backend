<div class="container mt-4 mb-5">
    <!-- Card: Tiêu đề và nút thêm -->
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h5 class="fw-semibold text-dark mb-0">Danh Sách Cửa Hàng</h5>
            <a href="/admin/cua-hang/them-moi" class="btn btn-sm btn-primary">Thêm cửa hàng</a>
        </div>
    </div>

    <!-- Card: Bảng danh sách -->
    <div class="card">
        <div class="card-body">
            <% if (Array.isArray(stores) && stores.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th>#</th>
                                <th>Tên cửa hàng</th>
                                <th>Địa chỉ</th>
                                <th>Điện thoại</th>
                                <th>Cửa hàng trưởng</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% stores.forEach((store, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= store.name %></td>
                                    <td><%= store.address %></td>
                                    <td><%= store.phone %></td>
                                    <td><%= store.StoreManager?.User?.name  || 'Chưa có' %></td>
                                    <td class="text-center">
                                        <a href="/admin/cua-hang/<%= store.store_id %>/chi-tiet" 
                                           class="btn btn-sm btn-outline-primary" title="Xem">
                                            Xem
                                        </a>
                                        <a href="/admin/cua-hang/<%= store.store_id %>/cap-nhat" 
                                           class="btn btn-sm btn-outline-primary" title="Sửa">
                                            Cập nhật
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="alert alert-info mb-0">Chưa có cửa hàng nào được thêm.</div>
            <% } %>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <%- include('../partials/common/paginationmall', {
                    currentPage: currentPage,
                    totalPages: totalPages,
                    baseUrl: '/admin/cua-hang/'
                }) %>
            <% } %>
        </div>
    </div>
</div>