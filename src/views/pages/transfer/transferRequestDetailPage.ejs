<% if (typeof toast !== 'undefined' && toast) { %>
    <script>
        alert('<%= toast.message.replace(/'/g, "\\'") %>');
        window.location.href = '/admin/don-yeu-cau/<%= transferRequest.transferRequestId %>/chi-tiet';
    </script>
<% } %>
             
<%
    function formatStatus(status) {
        switch(status) {
            case 'pending':
                return { text: 'Đang chờ xử lý', class: 'bg-warning text-white' };
            case 'approved':
                return { text: 'Đã xử lý', class: 'bg-success text-white' };
            default:
                return { text: status || '-', class: 'bg-danger text-white' };
        }
    };
%>

<div class="container py-5">
    <!-- Breadcrumb -->
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
        <%- include('../../partials/common/breadcrumb', { breadcrumbs }) %>
    <% } %>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="mb-4 text-cyan-700 text-uppercase">Thông tin yêu cầu chuyển cửa hàng</h1>
        <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary" aria-label="Quay lại trang trước">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card border-cyan-700 p-4">
        <!-- Tiêu đề -->
        <div class="text-center mb-3">
            <h4 class="fw-bold mb-1 text-cyan-700">Thông Tin Chi Tiết</h4>
            <p class="text-muted mb-0">Yêu cầu #<%= transferRequest.transferRequestId %></p>
            <hr class="">
        </div>

        <div class="row gap-1">
            <div class="col">
                <!-- Người liên quan -->
                <div class="mb-3">
                    <h6 class="text-cyan-700 fw-bold mb-3">
                        <i class="fa-solid fa-users me-1"></i> Thông tin liên quan
                    </h6>
                    <div class="row gap-3 px-3">
                        <% if (transferRequest.storeManager) { %>
                        <div class="col p-3 border rounded">
                            <h6 class="text-cyan-700 fw-bold mb-2">
                                <i class="fa-solid fa-user-tie me-1"></i> Quản lý cửa hàng
                            </h6>
                            <div class="d-flex align-items-center mb-2">
                                <img src="/images/<%= transferRequest.storeManager?.avatar ? transferRequest.storeManager.avatar : 'user.png' %>"
                                class="rounded-circle me-2"
                                style="width: 50px; height: 50px; object-fit: cover;"
                                onerror="this.onerror=null;this.src='/images/user.png';">
                                <div class="ms-4">
                                    <p class="mb-0"><strong>Tên:</strong> <%= transferRequest.storeManager.name || 'Không rõ' %></p>
                                    <p class="mb-0 text-muted"><i class="fa-solid fa-phone me-1"></i> <%= transferRequest.storeManager.phone || '-' %></p>
                                    <p class="mb-0 text-muted"><i class="fa-solid fa-envelope me-1"></i> <%= transferRequest.storeManager.email || '-' %></p>
                                </div>
                            </div>
                        </div>
                        <% } %>

                        <% if (transferRequest.technician) { %>
                        <div class="col p-3 border rounded">
                            <h6 class="text-cyan-700 fw-bold mb-2">
                                <i class="fa-solid fa-user-wrench me-1"></i> Kỹ thuật viên
                            </h6>
                            <div class="d-flex align-items-center mb-2">
                                <img src="/images/<%= transferRequest.technician?.avatar ? transferRequest.technician.avatar : 'user.png' %>"
                                    class="rounded-circle me-2"
                                    style="width: 50px; height: 50px; object-fit: cover;"
                                    onerror="this.onerror=null;this.src='/images/user.png';">
                                <div class="ms-4">
                                    <p class="mb-0"><strong>Tên:</strong> <%= transferRequest.technician.name || 'Không rõ' %></p>
                                    <p class="mb-0 text-muted"><i class="fa-solid fa-phone me-1"></i> <%= transferRequest.technician.phone || '-' %></p>
                                    <p class="mb-0 text-muted"><i class="fa-solid fa-envelope me-1"></i> <%= transferRequest.technician.email || '-' %></p>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Cửa hàng -->
                <div class="mb-3">
                    <h6 class="text-cyan-700 fw-bold mb-3"><i class="fa-solid fa-store me-1"></i> Cửa hàng chuyển</h6>
                    <div class="p-3 border rounded">
                        <p class="mb-1"><strong class="text-cyan-700">Từ cửa hàng:</strong> <%= transferRequest.fromStore?.name || '-' %></p>
                        <p class="mb-1"><strong class="text-cyan-700">Đến cửa hàng:</strong> <%= transferRequest.toStore?.name || '-' %></p>
                    </div>
                </div>

                <!-- Thông tin yêu cầu -->
                <div class="mb-3">
                    <h6 class="text-cyan-700 fw-bold mb-3"><i class="fa-solid fa-info-circle me-1"></i> Thông tin yêu cầu</h6>
                    <div class="p-3 border rounded">
                        <div class="row ">
                            <div class="col text-end">
                                <p class="fw-bold text-cyan-700 mb-1">Lý do:</p>
                                <p class="fw-bold text-cyan-700 mb-1">Trạng thái:</p>
                                <p class="fw-bold text-cyan-700 mb-1">Người xử lý:</p>
                                <p class="fw-bold text-cyan-700 mb-1">Ngày xử lý:</p>
                                <p class="fw-bold text-cyan-700 mb-1">Ghi chú:</p>
                                <p class="fw-bold text-cyan-700 mb-1">Ngày tạo:</p>
                            </div>
                            <div class="col-9 text-start">
                                <p class="text-cyan-800 mb-1"><%= transferRequest.reason || 'Không có' %></p>
                                <p class="text-cyan-800 mb-1">
                                    <span class="badge <%= formatStatus(transferRequest.status).class %>">
                                        <%= formatStatus(transferRequest.status).text %>
                                    </span>
                                </p>
                                <p class="text-cyan-800 mb-1">Quản trị viên <%= transferRequest.processedBy || 'Chưa xử lý' %></p>
                                <p class="text-cyan-800 mb-1">
                                     <%= transferRequest.processedAt 
                                        ? new Date(transferRequest.processedAt).toLocaleString('vi-VN') 
                                        : 'Chưa có' %>
                                </p>
                                <p class="text-cyan-800 mb-1"><%= transferRequest.note || 'Không có' %></p>
                                <p class="text-cyan-800 mb-1"><%= new Date(transferRequest.createdAt).toLocaleString('vi-VN') %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-4">
                <!-- Thông tin yêu cầu -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="text-cyan-700 fw-bold mb-3"><i class="fa-solid fa-receipt me-1"></i> Phiếu phản hồi</h6>
                    </div>
                    <form class="p-3 border rounded" action="/admin/don-yeu-cau/<%= transferRequest.transferRequestId %>/phan-hoi" method="POST">
                        <div class="form-floating mb-3">
                            <input type="hidden" name="technicianId" value="<%= transferRequest.technician?.id %>">
                            <input type="hidden" name="storeManagerId" value="<%= transferRequest.storeManager?.id %>">
                            <textarea 
                                name="note" 
                                id="note" 
                                class="form-control" 
                                placeholder="Nhập phản hồi..." 
                                style="height: 100px" 
                                rows="3"
                                <%= transferRequest.note ? 'disabled' : '' %>
                            ><%= transferRequest.note || '' %></textarea>
                            <label for="note">Phản hồi</label>
                        </div>
                        <button class="btn btn-secondary border-0 bg-cyan-700 text-white shadow-sm w-100" type="submit" <%= transferRequest.note ? 'disabled' : '' %>>
                            <i class="fa-solid fa-comment-dots"></i> Gửi phản hồi
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
