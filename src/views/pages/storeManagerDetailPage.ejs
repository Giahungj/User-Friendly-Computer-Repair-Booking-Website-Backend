<div class="container mt-4 mb-5">
    <!-- Card: Tiêu đề và nút quay lại -->
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h5 class="fw-semibold text-dark mb-0">Chi Tiết Quản Lý Cửa Hàng</h5>
            <a href="javascript:history.back()" class="btn btn-secondary btn-sm">Quay lại</a>
        </div>
    </div>

    <!-- Card: Thông tin quản lý -->
    <div class="card">
        <div class="card-body p-4">
            <% if (storeManager) { %>
              	<div class="row g-3 align-items-center">
					<div class="col-md-4 text-center">
						<img src="/images<%= storeManager.User.avatar || '/images/user.png' %>" 
							alt="Avatar" 
							class="rounded-circle border" 
							style="width: 120px; height: 120px; object-fit: cover;">
						<h6 class="mt-2 mb-1 fw-medium text-dark"><%= storeManager.User.name || '' %></h6>
						<small class="text-muted">Mã QLCH: <%= storeManager.store_manager_id %></small>
					</div>
					<div class="col-md-8">
						<table class="table table-sm table-bordered mb-0">
							<tbody>
								<tr>
									<th class="w-50">Email</th>
									<td><%= storeManager.User.email || '' %></td>
								</tr>
								<tr>
									<th>Điện thoại</th>
									<td><%= storeManager.User.phone || '' %></td>
								</tr>
								<tr>
									<th>Cửa hàng</th>
									<td><%= storeManager.Store?.name || 'Không rõ' %></td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
            <% } else { %>
                <div class="alert alert-warning mb-0">Không tìm thấy thông tin quản lý cửa hàng.</div>
            <% } %>
        </div>
    </div>
</div>