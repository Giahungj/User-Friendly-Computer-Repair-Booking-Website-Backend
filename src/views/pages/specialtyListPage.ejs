<!-- Card 1: Tiêu đề -->
<div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
        <h5 class="fw-semibold text-dark mb-0">Danh Sách Chuyên Môn</h5>
        <a href="/admin/chuyen-mon/them-moi" class="btn btn-success btn-sm">
            <i class="fa-solid fa-plus"></i> Thêm chuyên môn
        </a>
    </div>
</div>

<!-- Card 2: Table -->
<div class="card mb-3">
    <div class="card-body">
        <% if (EC === 0 && specialties.length > 0) { %>
            <table class="table table-hover table-bordered align-middle">
                <thead class="text-center">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Tên chuyên môn</th>
                        <th scope="col">Mô tả</th>
                        <th scope="col">Hình ảnh</th>
                        <th scope="col">Ngày tạo</th>
                    </tr>
                </thead>
                <tbody>
                    <% specialties.forEach((spec, index) => { %>
                        <tr>
                            <td class="text-center"><%= index + 1 %></td>
                            <td><%= spec.name %></td>
                            <td><%= spec.description || 'Không rõ' %></td>
                            <td>
                                <% if (spec.image) { %>
                                    <img src="/Uploads/<%= spec.image %>" alt="avatar" style="height: 80px;" class="rounded">
                                <% } else { %>
                                    <span class="text-danger">Không rõ</span>
                                <% } %>
                            </td>
                            <td><%= new Date(spec.createdAt).toLocaleDateString('vi-VN') %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <div class="alert alert-warning">Chưa có chuyên môn nào.</div>
        <% } %>
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <%- include('../partials/common/paginationmall', {
                currentPage: currentPage,
                totalPages: totalPages,
                baseUrl: '/admin/chuyen-mon/danh-sach'
            }) %>
        <% } %>
    </div>
</div>