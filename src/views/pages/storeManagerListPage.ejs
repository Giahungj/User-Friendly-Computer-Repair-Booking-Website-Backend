 <div class="container mt-4 mb-5">
    <!-- Card: Tiêu đề và nút thêm -->
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h5 class="fw-semibold text-dark mb-0">Danh Sách Cửa Hàng Trưởng</h5>
            <a href="/admin/cua-hang-truong/them-moi" class="btn btn-primary btn-sm">Thêm</a>
        </div>
    </div>

    <!-- Card: Tìm kiếm -->
    <div class="card mb-3">
        <div class="card-body">
            <%- include('../partials/searchs/searchStoreManager') %>
        </div>
    </div>

    <!-- Card: Bảng danh sách -->
    <div class="card">
        <div class="card-body">
            <% if (Array.isArray(managers) && managers.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th>#</th>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Điện thoại</th>
                                <th>Cửa hàng</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% managers.forEach((manager, index) => { %>
                                <tr>
                                    <td class="text-center"><%= index + 1 %></td>
                                    <td><%= manager.User.name %></td>
                                    <td><%= manager.User.email %></td>
                                    <td><%= manager.User.phone %></td>
                                    <td><%= manager.Store?.name || 'Chưa rõ' %></td>
                                    <td>
                                        <a href="/admin/cua-hang-truong/<%= manager.store_manager_id %>/chi-tiet" 
                                            class="btn btn-sm btn-outline-primary" title="Xem">Xem</a>
                                        <a href="/admin/cua-hang-truong/<%= manager.store_manager_id %>/cap-nhat" 
                                            class="btn btn-sm btn-outline-primary" title="Sửa">Sửa</a>
                                        <!-- <form action="/admin/cua-hang-truong/<%= manager.store_manager_id %>/xoa" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"
                                                    onclick="return confirm('Xác nhận xóa quản lý cửa hàng này?');">
                                                Xóa
                                            </button>
                                        </form> -->
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="alert alert-info mb-0">Chưa có cửa hàng trưởng nào được thêm.</div>
            <% } %>

            <!-- Phân trang -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <%- include('../partials/common/paginationmall', {
                    currentPage: currentPage,
                    totalPages: totalPages,
                    baseUrl: '/admin/cua-hang-truong/danh-sach'
                }); %>
            <% } %>
        </div>
    </div>
</div>