<div class="container mt-3">
    <!-- Card 1: Tiêu đề và nút quay lại -->
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h3 class="fw-semibold text-dark mb-0">Chi Tiết Khách Hàng</h3>
            <a href="/admin/khach-hang/danh-sach" class="btn btn-secondary btn-sm">Quay lại</a>
        </div>
    </div>

    <!-- Card: Thông tin khách hàng -->
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title fw-medium text-dark mb-3">Thông Tin Chi Tiết</h5>
            <% if (customer) { %>
                <div class="row">
                    <div class="col-md-4">
                        <table class="table table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th class="text-end" style="width:40%">Mã khách hàng:</th>
                                    <td class="<%= !customer.customer_id ? 'text-danger' : '' %>"><%= customer.customer_id || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Họ tên:</th>
                                    <td class="<%= !customer.User?.name ? 'text-danger' : '' %>"><%= customer.User?.name || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Email:</th>
                                    <td class="<%= !customer.User?.email ? 'text-danger' : '' %>"><%= customer.User?.email || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Số điện thoại:</th>
                                    <td class="<%= !customer.User?.phone ? 'text-danger' : '' %>"><%= customer.User?.phone || 'Không rõ' %></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="col-md-4">
                        <table class="table table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th class="text-end" style="width:10em">Liên hệ ưa thích:</th>
                                    <td class="<%= !customer.preferred_contact ? 'text-danger' : '' %>"><%= customer.preferred_contact || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Điểm tích lũy:</th>
                                    <td class="<%= !customer.loyalty_points ? 'text-danger' : '' %>"><%= customer.loyalty_points || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Ngày sinh:</th>
                                    <td class="<%= !customer.date_of_birth ? 'text-danger' : '' %>">
                                        <%= customer.date_of_birth ? new Date(customer.date_of_birth).toLocaleDateString('vi-VN') : 'Không rõ' %>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-end">Hình ảnh:</th>
                                    <td>
                                        <img src="/images/<%= customer.User.avatar %>.jpg"
                                             alt="Avatar"
                                             style="height: 80px; object-fit: cover; border: 2px solid #ccc;"
                                             onerror="this.onerror=null; this.src='/images/user.png';">
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="col-md-4">
                        <table class="table table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th class="text-end" style="width:35%">Địa chỉ:</th>
                                    <td class="<%= !customer.address ? 'text-danger' : '' %>"><%= customer.address || 'Không rõ' %></td>
                                </tr>
                                <tr>
                                    <th class="text-end">Ngày tạo:</th>
                                    <td class="<%= !customer.createdAt ? 'text-danger' : '' %>">
                                        <%= customer.createdAt ? new Date(customer.createdAt).toLocaleString('vi-VN') : 'Không rõ' %>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="alert alert-warning mb-0">Không tìm thấy thông tin khách hàng.</div>
            <% } %>
        </div>
    </div>
</div>