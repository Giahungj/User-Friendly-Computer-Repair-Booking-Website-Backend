<%
    function highlight(text, keyword) {
        if (!keyword) return text;
        const regex = new RegExp(`(${keyword})`, 'gi');
        return text.replace(regex, '<strong class="text-danger">$1</strong>');
    }
%>
<div class="container mt-4 vh-100">
    <!-- Card: Tiêu đề -->
     <div class="card mb-3">
		<div class="card-body d-flex justify-content-between align-items-center">
			<h3 class="fw-semibold text-dark mb-0">Danh Sách Khách Hàng</h3>
		</div>
	</div>

    <!-- Card: Tìm kiếm -->
    <%- include('../partials/searchs/searchCustomer') %>
    <!-- Card: Bảng danh sách -->
    <div class="card">
        <div class="card-body">
            <% if (Array.isArray(customers) && customers.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th>#</th>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Điện thoại</th>
                                <th>Địa chỉ</th>
                                <th>Liên hệ ưa thích</th>
                                <th>Điểm tích lũy</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% customers.forEach((customer, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%- highlight(customer.User?.name || '', searchQuery) %></td>
                                    <td><%- highlight(customer.User?.email || '', searchQuery) %></td>
                                    <td><%- highlight(customer.User?.phone || '', searchQuery) %></td>
                                    <td class="text-truncate" style="max-width: 180px;" title="<%= customer.address || '' %>"><%- highlight(customer.address || '', searchQuery) %></td>
                                    <td><%- highlight(customer.preferred_contact || '', searchQuery) %></td>
                                    <td><%= customer.loyalty_points || 0 %></td>
                                    <td class="text-center">
                                        <a href="/admin/khach-hang/<%= customer.customer_id %>/chi-tiet" 
                                           class="btn btn-sm btn-outline-primary w-100" title="">Xem
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="alert alert-info mb-0">Chưa có khách hàng nào được thêm.</div>
            <% } %>
        </div>
    </div>
</div>