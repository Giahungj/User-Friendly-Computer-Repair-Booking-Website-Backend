<%
    function highlight(text, keyword) {
        if (!keyword) return text;
        const regex = new RegExp(`(${keyword})`, 'gi');
        return text.replace(regex, '<strong class="text-danger">$1</strong>');
    }
%>

<div class="container py-5">
    <!-- Breadcrumb (có thể tái sử dụng) -->
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
        <%- include('../../partials/common/breadcrumb', { breadcrumbs }) %>
    <% } %>

    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="mb-4 text-cyan-700">Danh sách kỹ thuật viên</h1>
        <a href="/admin/ky-thuat-vien/them-moi" class="btn btn-sm btn-secondary border-0 bg-cyan-700 text-white shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Thêm kỹ thuật viên
        </a>
    </div>
    
    <%- include('../../partials/search/searchTechnician') %>

    <hr>

    <% if (Array.isArray(technicians) && technicians.length > 0) { %>
        <div class="table-responsive">
            <table id="dataTable" class="table table-dark table-hover" style="width:100%">
                <thead class="text-center">
                    <tr>
                        <th>#</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th>Cửa hàng</th>
                        <!-- <th>Hoạt động gần nhất</th> -->
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% technicians.forEach((tech, index) => { %>
                        <tr>
                            <td class="text-center"><%= (currentPage - 1) * 20 + index + 1 %></td>
                            <td><%- highlight(tech.User.name || '', searchQuery) %></td>
                            <td><%- highlight(tech.User.email || '', searchQuery) %></td>
                            <td><%- highlight(tech.User.phone || '', searchQuery) %></td>
                            <td><%= tech.Store?.name || 'Chưa rõ' %></td>
                            <!-- <td><%= tech.User?.last_active ? new Date(tech.User?.last_active).toLocaleString('vi-VN') : 'Chưa đăng nhập' %></td> -->
                            <td class="text-center">
                                <a href="/admin/ky-thuat-vien/<%= tech.technician_id %>/chi-tiet" class="btn btn-sm btn-secondary border-0 bg-cyan-700 text-white shadow-sm">
                                    <i class="fa-regular fa-eye me-1"></i> Xem
                                </a>
                                <a href="/admin/ky-thuat-vien/<%= tech.technician_id %>/doi-cua-hang" class="btn btn-sm btn-secondary border-0 bg-cyan-700 text-white shadow-sm">
                                    <i class="fa-solid fa-rotate me-1"></i> Đổi cửa hàng
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="alert alert-info mb-0">Chưa có kỹ thuật viên nào được thêm.</div>
    <% } %>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <%- include('../../partials/common/pagination', {
            currentPage: currentPage,
            totalPages: totalPages,
            baseUrl: '/admin/ky-thuat-vien/danh-sach'
        }) %>
    <% } %>
</div>
