<div class="container py-5">
	<div class="row justify-content-center">
		<div class="col-lg-8 col-xl-7">
			<div class="card border-0 rounded-3 overflow-hidden">
				<div class="card-header bg-cyan-700 text-white border-bottom-0 py-3 d-flex justify-content-between align-items-center">
					<h5 class="mb-0 text-uppercase fw-semibold d-flex align-items-center">
						<i class="fa-solid fa-user-gear me-2"></i> Thêm kỹ thuật viên
					</h5>
				</div>
				<div class="card-body p-4">
					<form action="/admin/ky-thuat-vien/them-moi" method="POST" enctype="multipart/form-data" class="row g-4 needs-validation" novalidate>
						<div class="col-md-6">
							<div class="form-floating">
								<input type="text" class="form-control" id="name" name="name" placeholder="Nhập họ tên" required>
								<label for="name">Họ tên <span class="badge bg-danger ms-1">*</span></label>
								<div class="invalid-feedback">Vui lòng nhập họ tên.</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-floating">
								<input type="email" class="form-control" id="email" name="email" placeholder="Nhập email" required>
								<label for="email">Email <span class="badge bg-danger ms-1">*</span></label>
								<div class="invalid-feedback">Vui lòng nhập email hợp lệ.</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-floating">
								<input type="password" class="form-control" id="password" name="password" placeholder="Nhập mật khẩu" required>
								<label for="password">Mật khẩu <span class="badge bg-danger ms-1">*</span></label>
								<div class="invalid-feedback">Vui lòng nhập mật khẩu.</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-floating">
								<input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Nhập lại mật khẩu" required>
								<label for="confirmPassword">Xác nhận mật khẩu <span class="badge bg-danger ms-1">*</span></label>
								<div class="invalid-feedback">Vui lòng xác nhận mật khẩu.</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-floating">
								<input type="text" class="form-control" id="phone" name="phone" placeholder="Nhập số điện thoại" required pattern="[\d]{10,11}">
								<label for="phone">Số điện thoại <span class="badge bg-danger ms-1">*</span></label>
								<div class="invalid-feedback">Số điện thoại không hợp lệ (10-11 chữ số).</div>
							</div>
						</div>
						<div class="col-md-6">
							<label class="form-label d-block">Ảnh đại diện (tùy chọn)</label>
							<input type="file" class="form-control" id="avatar" name="avatar" accept="image/*">
							<div class="form-text">JPG/PNG, tối đa 2MB.</div>
							<div class="mt-2 text-center">
								<img id="image-preview" class="img-thumbnail d-none" style="max-height: 150px; max-width: 100%;" alt="Preview ảnh đại diện" />
								<p id="no-preview-text" class="text-muted small m-0">Preview sẽ hiển thị sau khi chọn.</p>
							</div>
						</div>
						<div class="col-12">
							<label class="form-label">Chuyên môn <span class="badge bg-danger ms-1">*</span></label>
							<div class="row g-2" id="specialty-group">
								<% specialties.forEach(spec => { %>
									<div class="col-md-4 col-6">
										<div class="form-check">
											<input type="checkbox" class="form-check-input specialty-check" name="specialty" id="<%= spec.specialty_id %>" value="<%= spec.specialty_id %>">
											<label class="form-check-label" for="<%= spec.specialty_id %>"><%= spec.name %></label>
										</div>
									</div>
								<% }) %>
							</div>
							<div class="invalid-feedback d-block mt-2">Vui lòng chọn ít nhất 1 chuyên môn.</div>
						</div>
						<div class="col-12">
							<div class="form-floating">
								<select class="form-select" id="store" name="store_id" required>
									<option value="">-- Chọn cơ sở làm việc --</option>
									<% stores.forEach(sto => { %>
										<option value="<%= sto.store_id %>"><%= sto.name %></option>
									<% }) %>
								</select>
								<label for="store">Cơ sở làm việc <span class="badge bg-danger ms-1">*</span></label>
								<div class="invalid-feedback">Vui lòng chọn cơ sở.</div>
							</div>
						</div>
						<div class="col-12 d-flex justify-content-end gap-3">
                            <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
							<button type="submit" class="btn btn-secondary border-0 bg-cyan-700 text-white shadow-sm px-4">
								<i class="fa-solid fa-plus me-1"></i> Thêm kỹ thuật viên
								<span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
							</button>
						</div>
					</form>
				</div>
				<div class="card-footer bg-white border-top-0 text-muted small">
					<i class="fa-solid fa-info-circle me-1"></i> Các trường đánh dấu * là bắt buộc (bao gồm ít nhất 1 chuyên môn). Dữ liệu sẽ được lưu sau khi submit.
				</div>
			</div>
		</div>
	</div>
</div>
<style>
	.card {
		transition: all 0.2s ease;
	}
	.card:focus-within {
		box-shadow: 0 0 1em 0.2rem rgba(58, 169, 194, 0.35);
	}
	.form-floating > label {
		font-size: 0.9rem;
	}
	.badge {
		font-size: 0.7rem;
	}
	#specialty-group .invalid-feedback {
		display: none;
	}
	.was-validated #specialty-group:invalid ~ .invalid-feedback,
	#specialty-group.invalid ~ .invalid-feedback {
		display: block;
	}
</style>
<script>
	// Image preview
	document.getElementById('avatar').addEventListener('change', function(e) {
		const file = e.target.files[0];
		const preview = document.getElementById('image-preview');
		const noPreviewText = document.getElementById('no-preview-text');
		if (file) {
			const reader = new FileReader();
			reader.onload = function(ev) {
				preview.src = ev.target.result;
				preview.classList.remove('d-none');
				noPreviewText.classList.add('d-none');
			};
			reader.readAsDataURL(file);
		} else {
			preview.classList.add('d-none');
			noPreviewText.classList.remove('d-none');
		}
	});
	// Bootstrap validation + specialties min 1 + spinner
	(function () {
		'use strict';
		const form = document.querySelector('.needs-validation');
		const specialtyGroup = document.getElementById('specialty-group');
		const specialties = document.querySelectorAll('.specialty-check');
		const spinner = document.querySelector('.spinner-border');
		// Custom validity for specialties
		function validateSpecialties() {
			const checked = Array.from(specialties).some(check => check.checked);
			specialtyGroup.classList.toggle('invalid', !checked);
			specialtyGroup.setCustomValidity(checked ? '' : 'invalid');
		}
		specialties.forEach(check => check.addEventListener('change', validateSpecialties));
		form.addEventListener('submit', function (event) {
			validateSpecialties();
			if (!form.checkValidity() || specialtyGroup.classList.contains('invalid')) {
				event.preventDefault();
				event.stopPropagation();
			} else {
				spinner.classList.remove('d-none');
			}
			form.classList.add('was-validated');
		}, false);
	})();
</script>   