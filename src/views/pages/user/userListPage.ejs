<%
    function highlight(text, keyword) {
        if (!keyword) return text;
        const regex = new RegExp(`(${keyword})`, 'gi');
        return text.replace(regex, '<strong class="text-danger">$1</strong>');
    }
%>
<div class="container py-5">
    <!-- Card: Tiêu đề và nút thêm -->
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h5 class="fw-semibold text-dark mb-0">Danh Sách Tài Khoản</h5>
        </div>
    </div>

    <!-- Card: Tìm kiếm -->
    <div class="card mb-3">
        <div class="card-body">
            <%- include('../../partials/search/searchUser') %>
        </div>
    </div>

    <!-- Card: Bảng danh sách -->
    <div class="card">
        <div class="card-body">
            <% if (Array.isArray(users) && users.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th>#</th>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Điện thoại</th>
                                <th>Vai trò</th>
                                <!-- <th>Hoạt động gần nhất</th> -->
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach((user, index) => { %>
                                <tr>
                                    <td class="text-center"><%= (currentPage - 1) * 20 + index + 1 %></td>
                                    <td><%- highlight(user.name || '', searchQuery) %></td>
                                    <td><%- highlight(user.email || '', searchQuery) %></td>
                                    <td><%- highlight(user.phone || '', searchQuery) %></td>
                                    <td><%= user.role || 'Chưa phân quyền' %></td>
                                    <!-- <td><%= user.last_active ? new Date(user.last_active).toLocaleString('vi-VN') : 'Chưa đăng nhập' %></td> -->
                                    <td>
                                        <a href="/admin/tai-khoan/<%= user.user_id %>/chi-tiet" 
                                           class="btn btn-sm btn-outline-primary w-100" title="Xem">Xem</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="alert alert-info mb-0">Chưa có tài khoản nào được thêm.</div>
            <% } %>

            <!-- Phân trang -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <%- include('../../partials/common/pagination', {
                    currentPage: currentPage,
                    totalPages: totalPages,
                    baseUrl: '/admin/tai-khoan/danh-sach'
                }) %>
            <% } %>
        </div>
    </div>
</div>