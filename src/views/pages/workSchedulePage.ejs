<div class="container mt-3">
	<!-- Card 1: Tiêu đề -->
	<div class="card mb-3">
		<div class="card-body text-center">
			<h3 class="fw-semibold text-dark mb-0">Lịch Làm Việc Nhân Viên</h3>
		</div>
	</div>

	<!-- Card 2: Form tìm kiếm -->
	<div class="card mb-3">
		<div class="card-body">
			<form method="GET" action="/admin/lich-lam-viec/danh-sach" class="row g-3">
				<div class="col-md-5">
					<label for="technicianId" class="form-label fw-medium text-dark">Kỹ thuật viên</label>
					<select name="technicianId" id="technicianId" class="form-select">
						<option value="">-- Chọn kỹ thuật viên --</option>
						<% technicians.forEach(t => { %>
							<option value="<%= t.technician_id %>" <%= selectedTechnician == t.technician_id ? 'selected' : '' %>>
								<%= t.name %>
							</option>
						<% }) %>
					</select>
				</div>
				<div class="col-md-4">
					<label for="date" class="form-label fw-medium text-dark">Ngày</label>
					<input type="date" id="date" name="date" class="form-control" value="<%= selectedDate || '' %>">
				</div>
				<div class="col-md-3 d-flex align-items-end">
					<button type="submit" class="btn btn-primary w-100">Xem</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Card 3: Thông tin kỹ thuật viên -->
	<% if (technicianName) { %>
		<div class="card mb-3">
			<div class="card-body text-center">
				<span class="fw-medium text-dark">Kỹ thuật viên: </span>
				<span class="text-primary"><%= technicianName %></span>
			</div>
		</div>
	<% } %>

	<!-- Card 4: Lịch -->
	<div class="card mb-3">
		<div class="card-body p-3">
			<div id="calendar" style="min-height: 500px;"></div>
		</div>
	</div>
</div>

<!-- FullCalendar CSS & JS -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		const calendarEl = document.getElementById('calendar');
		const calendar = new FullCalendar.Calendar(calendarEl, {
			initialView: 'dayGridMonth',
			locale: 'vi',
			height: 'auto',
			events: <%- JSON.stringify(events || []) %>,
			eventColor: '#007bff',
			eventDidMount: function(info) {
				info.el.style.borderRadius = '6px';
				info.el.style.padding = '4px';
				if (info.event.title.includes("pin")) info.el.style.backgroundColor = '#ffc107';
				if (info.event.title.includes("main")) info.el.style.backgroundColor = '#dc3545';
			},
			eventClick: function(info) {
				if (info.event.extendedProps && info.event.extendedProps.technicianId) {
					window.location.href = `/admin/ky-thuat-vien/${info.event.extendedProps.technicianId}/chi-tiet`;
				} else {
					alert("Không có thông tin kỹ thuật viên cho sự kiện này!");
				}
			}
		});
		calendar.render();
	});
</script>
