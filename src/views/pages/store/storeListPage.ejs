<%
    function highlight(text, keyword) {
        if (!keyword) return text;
        const regex = new RegExp(`(${keyword})`, 'gi');
        return text.replace(regex, '<strong class="text-danger">$1</strong>');
    }
%>

<div class="container py-5">
    <!-- Breadcrumb (nếu có) -->
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
        <%- include('../../partials/common/breadcrumb', { breadcrumbs }) %>
    <% } %>

    <!-- Tiêu đề trang và nút thêm -->
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="text-cyan-700 mb-4">Danh Sách Cửa Hàng</h1>
        <a href="/admin/cua-hang/them-moi" class="btn btn-secondary border-0 bg-cyan-700 text-white shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Thêm cửa hàng
        </a>
    </div>

    <%- include('../../partials/search/searchStore') %>

    <hr>

    <!-- Bảng danh sách -->
    <% if (Array.isArray(stores) && stores.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle" style="width:100%">
                <thead class="text-center">
                    <tr>
                        <th>#</th>
                        <th>Tên cửa hàng</th>
                        <th>Địa chỉ</th>
                        <th>Điện thoại</th>
                        <th>Cửa hàng trưởng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% stores.forEach((store, index) => { %>
                        <tr>
                            <td class="text-center"><%= (currentPage - 1) * 20 + index + 1 %></td>
                            <td><%- highlight(store.name || '', searchQuery) %></td>
                            <td><%- highlight(store.address || '', searchQuery) %></td>
                            <td><%- highlight(store.phone || '', searchQuery) %></td>
                            <td>
                                <% if (store.StoreManager?.User?.name) { %>
                                    <img src="/images<%= store.StoreManager.User.avatar %>" alt="Avatar" class="rounded-circle me-1" style="width:34px; height:34px; object-fit:cover;">
		                            <%= store.StoreManager.User.name %>
                                <% } else { %>
                                    <span class="text-red-300 fw-semibold">Chưa có</span>
                                <% } %>
                            </td>
                            <td class="text-center">
                                <a href="/admin/cua-hang/<%= store.store_id %>/chi-tiet" 
                                   class="btn btn-sm btn-secondary border-0 bg-cyan-700 text-white shadow-sm" title="Xem">
                                    Xem
                                </a>
                                <a href="/admin/cua-hang/<%= store.store_id %>/cap-nhat" 
                                   class="btn btn-sm btn-secondary border-0 bg-cyan-700 text-white shadow-sm" title="Sửa">
                                    Cập nhật
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="alert alert-info mb-0">Không có cửa hàng nào.</div>
    <% } %>

    <!-- Phân trang -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <%- include('../../partials/common/pagination', {
            currentPage: currentPage,
            totalPages: totalPages,
            baseUrl: '/admin/cua-hang/danh-sach'
        }) %>
    <% } %>
</div>
