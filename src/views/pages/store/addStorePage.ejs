<div class="container py-5">
    <!-- Breadcrumb (có thể tái sử dụng) -->
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
        <%- include('../../partials/common/breadcrumb', { breadcrumbs }) %>
    <% } %>
    
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card border-0 overflow-hidden">
                <div class="card-header bg-cyan-700 text-white border-bottom-0 py-3">
                    <h5 class="mb-0 text-uppercase fw-semibold d-flex align-items-center">
                        <i class="fa-solid fa-store me-2"></i> Thêm cửa hàng mới
                    </h5>
                </div>
                <div class="card-body p-3">
                    <form action="/admin/cua-hang/them-moi" method="POST" enctype="multipart/form-data" class="row g-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="name" name="name" placeholder="Nhập tên cửa hàng" required>
                                <label for="name">Tên cửa hàng <span class="badge bg-danger ms-1">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="tel" class="form-control" id="phone" name="phone" placeholder="Nhập số điện thoại" required pattern="[\d]{10,11}">
                                <label for="phone">Số điện thoại <span class="badge bg-danger ms-1">*</span></label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="address" name="address" placeholder="Nhập địa chỉ đầy đủ" required>
                                <label for="address">Địa chỉ <span class="badge bg-danger ms-1">*</span></label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="accordion" id="uploadAccordion">
                                <div class="accordion-item border-0">
                                    <h2 class="accordion-header" id="headingImage">
                                        <button class="accordion-button collapsed bg-white shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseImage" aria-expanded="false" aria-controls="collapseImage">
                                            <i class="fa-solid fa-image me-2"></i> Hình ảnh cửa hàng <span class="badge bg-danger ms-1">*</span>
                                        </button>
                                    </h2>
                                    <div id="collapseImage" class="accordion-collapse collapse" aria-labelledby="headingImage" data-bs-parent="#uploadAccordion">
                                        <div class="accordion-body pt-3">
                                            <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
                                            <div class="form-text mt-2">JPG/PNG, tối đa 2MB. Kéo thả hoặc chọn file.</div>
                                            <div class="mt-3 text-center">
                                                <img id="image-preview" class="img-thumbnail d-none" style="max-height: 200px; max-width: 100%;" alt="Preview hình ảnh cửa hàng" />
                                                <p id="no-preview-text" class="text-muted small mt-2">Preview sẽ hiển thị sau khi chọn file.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-3">
                            <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-secondary border-0 bg-cyan-700 text-white shadow-sm">
                                <i class="fa-solid fa-plus me-1"></i> Thêm cửa hàng
                                <span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-white border-top-0 text-muted small">
                    <i class="fa-solid fa-info-circle me-1"></i> Các trường đánh dấu * là bắt buộc. Dữ liệu sẽ được lưu tự động sau submit.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card { 
        transition: none; 
    }
    .card:focus-within {
        box-shadow: 0 0 1em 0.2rem rgba(58, 169, 194, 0.35);
    }
    .form-floating > label { 
        font-size: 0.9rem; 
    }
    .badge { 
        font-size: 0.7rem; 
    }
</style>

<script>
    // Image preview function
    document.getElementById('image').addEventListener('change', function(e) {
        const file = e.target.files[0];
        const preview = document.getElementById('image-preview');
        const noPreviewText = document.getElementById('no-preview-text');
        if (file) {
            const reader = new FileReader();
            reader.onload = function(ev) {
                preview.src = ev.target.result;
                preview.classList.remove('d-none');
                noPreviewText.classList.add('d-none');
            };
            reader.readAsDataURL(file);
        } else {
            preview.classList.add('d-none');
            noPreviewText.classList.remove('d-none');
        }
    });
</script>