<div class="container py-5">
    <!-- Breadcrumb (có thể tái sử dụng) -->
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
        <%- include('../../partials/common/breadcrumb', { breadcrumbs }) %>
    <% } %>

    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="mb-4 text-cyan-700">Cập nhật cửa hàng</h1>
		<a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
    </div>

    <!-- Card: Form cập nhật thông tin cửa hàng -->
    <div class="card mb-3 border-cyan-700">
        <h3 class="card-header bg-cyan-700 text-white">
            Thông Tin Cửa Hàng
        </h3>
        <div class="card-body">
            <% if (store) { %>
                <form action="/admin/cua-hang/<%= store.store_id %>/cap-nhat" method="POST" enctype="multipart/form-data">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <div class="mb-3">
                                    <label class="form-label fw-medium text-muted">Mã cửa hàng</label>
                                    <input type="text" class="form-control" value="<%= store.store_id || 'Không rõ' %>" readonly disabled>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-medium text-muted">Ngày tạo</label>
                                    <input type="text" class="form-control" value="<%= store.createdAt ? new Date(store.createdAt).toLocaleString('vi-VN') : 'Không rõ' %>" readonly disabled>
                                </div>
                                
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <div class="mb-3">
                                    <label class="form-label fw-medium text-muted">Tên cửa hàng <span class="text-danger">*</span></label>
                                    <input type="text" name="name" class="form-control" value="<%= store.name || '' %>" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-medium text-muted">Số điện thoại <span class="text-danger">*</span></label>
                                    <input type="text" name="phone" class="form-control" value="<%= store.phone || '' %>" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-medium text-muted">Địa chỉ <span class="text-danger">*</span></label>
                                    <input type="text" name="address" class="form-control" value="<%= store.address || '' %>" required>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-medium text-muted">Hình ảnh</label>
                                    <div class="mb-2">
                                        <img src="/images/<%= store.store_image %>"
                                            alt="Store Image"
                                            class="rounded"
                                            style="height: 100px; object-fit: cover; border: 2px solid #e9ecef;"
                                            onerror="this.onerror=null; this.src='/images/user.png';">
                                    </div>
                                    <input type="file" name="store_image" class="form-control" accept="image/*">
                                </div>

                                <div class="mb-3">
                                    <button type="submit" class="btn btn-outline-secondary bg-cyan-700 text-white px-4 w-100">
                                        <i class="fa-solid fa-save me-2"></i> Lưu thay đổi
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            <% } else { %>
                <div class="alert alert-warning mb-0">Không tìm thấy thông tin cửa hàng.</div>
            <% } %>
        </div>
    </div>
</div>