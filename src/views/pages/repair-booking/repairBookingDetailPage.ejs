<div class="container  py-5">
  <!-- Breadcrumb (có thể tái sử dụng) -->
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
        <%- include('../../partials/common/breadcrumb', { breadcrumbs }) %>
    <% } %>

    <!-- Card: Tiêu đề và nút thêm -->
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="mb-4 text-cyan-700 text-uppercase">Thông tin đơn đặt lịch</h1>
        <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary" aria-label="Quay lại trang trước">
          <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
  <div class="card border-cyan-700 p-4">
    <!-- Header -->
    <div class="text-center mb-4">
      <h4 class="fw-bold mb-1 text-cyan-700">Chi Tiết Đơn Đặt Lịch</h4>
      <p class="text-muted mb-0">Thông tin chi tiết đơn đặt lịch</p>
      <hr class="my-3">
    </div>

    <!-- Người dùng -->
    <div class="mb-4">
      <h6 class="text-cyan-700 fw-bold mb-3"><i class="fa-solid fa-users me-1"></i> Thông tin người dùng</h6>
      <div class="row g-3">
        <% if (customerData && customerData.User) { %>
          <div class="col-12">
            <div class="p-3 border rounded">
              <h6 class="text-cyan-700 fw-bold mb-2"><i class="fa-solid fa-user me-1"></i> Khách hàng</h6>
              <div class="d-flex align-items-center mb-2">
                <img src="/images/<%= customerData.User.avatar || 'user.png' %>" class="rounded-circle me-2" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/user.png';">
                <div>
                  <p class="mb-0"><strong class="text-cyan-700">Tên:</strong> <%= customerData.User.name %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-phone me-1"></i> <%= customerData.User.phone || '-' %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-envelope me-1"></i> <%= customerData.User.email || '-' %></p>
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <% if (managerData && managerData.User) { %>
          <div class="col-12">
            <div class="p-3 border rounded">
              <h6 class="text-cyan-700 fw-bold mb-2"><i class="fa-solid fa-user-tie me-1"></i> Quản lý Cửa hàng</h6>
              <div class="d-flex align-items-center mb-2">
                <img src="/images/<%= managerData.User.avatar || 'user.png' %>" class="rounded-circle me-2" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/user.png';">
                <div>
                  <p class="mb-0"><strong class="text-cyan-700">Tên:</strong> <%= managerData.User.name %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-phone me-1"></i> <%= managerData.User.phone || '-' %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-envelope me-1"></i> <%= managerData.User.email || '-' %></p>
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <% if (technicianData && technicianData.User) { %>
          <div class="col-12">
            <div class="p-3 border rounded">
              <h6 class="text-cyan-700 fw-bold mb-2"><i class="fa-solid fa-user-wrench me-1"></i> Kỹ thuật viên</h6>
              <div class="d-flex align-items-center mb-2">
                <img src="/images/<%= technicianData.User.avatar || 'user.png' %>" class="rounded-circle me-2" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/user.png';">
                <div>
                  <p class="mb-0"><strong class="text-cyan-700">Tên:</strong> <%= technicianData.User.name || 'Chưa chỉ định' %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-phone me-1"></i> <%= technicianData.User.phone || '-' %></p>
                  <p class="mb-0 text-muted"><i class="fa-solid fa-envelope me-1"></i> <%= technicianData.User.email || '-' %></p>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Lịch đặt -->
    <div class="mb-4">
		<h6 class="text-cyan-700 fw-bold mb-3"><i class="fa-solid fa-calendar-days me-1"></i> Chi tiết lịch đặt</h6>
		<% if (repairBooking) { %>
			<div class="p-3 border rounded">
				<p class="mb-1"><strong class="text-cyan-700">Mã đặt lịch:</strong> <%= repairBooking.booking_id %></p>
				<p class="mb-1"><strong class="text-cyan-700">Thiết bị:</strong> <%= repairBooking.device_type || '-' %></p>
				<p class="mb-1"><strong class="text-cyan-700">Hãng:</strong> <%= repairBooking.brand || '-' %></p>
				<p class="mb-1"><strong class="text-cyan-700">Ngày đặt:</strong> 
					<%= repairBooking.booking_date 
					? new Date(repairBooking.booking_date).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) 
					: '-' %>
				</p>
				<p class="mb-1"><strong class="text-cyan-700">Giờ đặt:</strong> <%= repairBooking.booking_time || '-' %></p>
				<p class="mb-1"><strong class="text-cyan-700">Mô tả lỗi:</strong> <%= repairBooking.issue_description || 'Không có' %></p>
				<p class="mb-1"><strong class="text-cyan-700">Trạng thái:</strong>
					<span class="badge 
					<%= repairBooking.status === 'pending' ? 'bg-warning text-dark' :
						repairBooking.status === 'completed' ? 'bg-success' :
						repairBooking.status === 'in-progress' ? 'bg-info text-dark' : 'bg-secondary' %>">
					<%= repairBooking.status || 'Không xác định' %>
					</span>
				</p>
			</div>
		<% } %>
	</div>

    <!-- Chi nhánh -->
    <div class="mb-4">
      <h6 class="text-cyan-700 fw-bold mb-3"><i class="fa-solid fa-store me-1"></i> Thông tin chi nhánh</h6>
      <% if (storeData) { %>
        <div class="p-3 border rounded">
          <p class="mb-1"><strong class="text-cyan-700">Tên chi nhánh:</strong> <%= storeData.name || '-' %></p>
          <p class="mb-1"><strong class="text-cyan-700">Địa chỉ:</strong> <%= storeData.address || '-' %></p>
          <p class="mb-1"><strong class="text-cyan-700">Số điện thoại:</strong> <%= storeData.phone || '-' %></p>
          <p class="mb-1"><strong class="text-cyan-700">Email:</strong> <%= storeData.email || '-' %></p>
        </div>
      <% } %>
    </div>
</div>
</div>