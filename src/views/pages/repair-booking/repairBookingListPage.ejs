<%
    function highlight(text, keyword) {
        if (!keyword) return text;
        const regex = new RegExp(`(${keyword})`, 'gi');
        return text.replace(regex, '<strong class="text-danger">$1</strong>');
    }
%>
<div class="container py-5">
    <!-- Breadcrumb (có thể tái sử dụng) -->
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
        <%- include('../../partials/common/breadcrumb', { breadcrumbs }) %>
    <% } %>

   <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="mb-4 text-cyan-700 text-uppercase">Danh sách đơn đặt lịch</h1>
    </div>

    <!-- Card: Tìm kiếm và bộ lọc -->
    <%- include('../../partials/search/searchRepairBooking') %>
    <%- include('../../partials/filters/filterRepairBookingForm') %>

    <!-- Card: Bảng danh sách -->
    <div class="card border-cyan-700">
        <div class="card-body">
            <% if (Array.isArray(bookings) && bookings.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th>#</th>
                                <th>Khách hàng</th>
                                <th>Kỹ thuật viên</th>
                                <th>Thời gian</th>
                                <th>Trạng thái</th>
                                <th>Hãng</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% bookings.forEach((item, index) => { %>
                                <tr>
                                    <td class="text-center"><%= (currentPage - 1) * 20 + index + 1 %></td>
                                    <td><%- highlight(item.Customer?.User?.name || '', searchQuery) %></td>
                                    <td><%- highlight(item.WorkSchedule?.Technician?.User?.name || '', searchQuery) %></td>
                                    <td><%= item.booking_date ? new Date(item.booking_date).toLocaleDateString('vi-VN') : '' %></td>
                                    <td 
                                        <% if (item.status === 'pending') { %>class="bg-warning" 
                                        <% } else if (item.status === 'completed') { %>class="bg-success text-white" 
                                        <% } else if (item.status === 'in-progress') { %>class="bg-danger text-white" 
                                        <% } else { %>class="bg-info" 
                                        <% } %>>
                                        <%- highlight(item.status || '', searchQuery) %>
                                    </td>
                                    <td><%- highlight(item.brand || '', searchQuery) %></td>
                                    <td>
                                        <a href="/admin/dat-lich/<%= item.booking_id %>/chi-tiet" class="btn btn-sm btn-outline-primary" title="Xem">Xem</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="alert alert-info mb-0">Chưa có lịch sửa chữa nào được thêm.</div>
            <% } %>

            <!-- Phân trang -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <%- include('../../partials/common/pagination', {
                    currentPage: currentPage,
                    totalPages: totalPages,
                    baseUrl: '/admin/dat-lich/danh-sach'
                }) %>
            <% } %>
        </div>
    </div>
</div>